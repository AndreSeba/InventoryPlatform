@page "/areas"
@rendermode InteractiveServer
@inject AreaApiClient AreaApi

<PageTitle>Áreas</PageTitle>

<h1>Áreas</h1>

@if (_error is not null)
{
    <p class="error">@_error</p>
}

<EditForm Model="_modelo" OnValidSubmit="CrearAsync" FormName="crearArea">
    <div class="fila">
        <div class="campo">
            <label>Código</label>
            <InputText @bind-Value="_modelo.CodigoArea" placeholder="MARKETING" />
        </div>
        <div class="campo">
            <label>Nombre</label>
            <InputText @bind-Value="_modelo.NombreArea" placeholder="Marketing" />
        </div>
        <button type="submit" disabled="@_guardando">@(_guardando ? "Guardando…" : "Agregar")</button>
    </div>
</EditForm>

@if (_areas is null)
{
    <p>Cargando…</p>
}
else
{
    <table>
        <thead><tr><th>Código</th><th>Nombre</th></tr></thead>
        <tbody>
            @foreach (var a in _areas)
            {
                <tr><td>@a.CodigoArea</td><td>@a.NombreArea</td></tr>
            }
        </tbody>
    </table>
}

<style>
    .fila { display: flex; gap: 1rem; align-items: flex-end; margin-bottom: 1.25rem; flex-wrap: wrap; }
    .campo { display: flex; flex-direction: column; gap: .25rem; }
    label { font-weight: 600; font-size: .85rem; }
    input { padding: .4rem; border: 1px solid #ccc; border-radius: 4px; min-width: 220px; }
    button { padding: .5rem 1rem; background: #1f3864; color: #fff; border: none; border-radius: 4px; cursor: pointer; height: fit-content; }
    button:disabled { opacity: .6; cursor: default; }
    table { border-collapse: collapse; width: 100%; }
    th, td { border: 1px solid #ddd; padding: .5rem .75rem; text-align: left; }
    th { background: #f7f9fc; }
    .error { color: #a33; font-weight: 600; }
</style>

@code {
    private List<AreaDto>? _areas;
    private readonly Modelo _modelo = new();
    private bool _guardando;
    private string? _error;

    protected override async Task OnInitializedAsync() => await CargarAsync();

    private async Task CargarAsync()
    {
        try { _areas = await AreaApi.ListarAsync(); }
        catch (ApiException ex) { _error = ex.Message; _areas = []; }
    }

    private async Task CrearAsync()
    {
        if (_guardando) return;
        _guardando = true;
        _error = null;
        try
        {
            await AreaApi.CrearAsync(new CrearAreaDto(_modelo.CodigoArea, _modelo.NombreArea));
            _modelo.CodigoArea = "";
            _modelo.NombreArea = "";
            await CargarAsync();
        }
        catch (ApiException ex) { _error = ex.Message; }
        finally { _guardando = false; }
    }

    private class Modelo
    {
        public string CodigoArea { get; set; } = "";
        public string NombreArea { get; set; } = "";
    }
}
