@page "/productos"
@rendermode InteractiveServer
@inject ProductoApiClient ProductoApi

<PageTitle>Productos</PageTitle>

<h1>Catálogo de productos</h1>

<p>
    <a href="/productos/crear">+ Nuevo producto</a>
    &nbsp;|&nbsp;
    <a href="/movimientos/registrar">Registrar movimiento</a>
</p>

@if (_error is not null)
{
    <p class="error">@_error</p>
}

@if (_productos is null)
{
    <p>Cargando…</p>
}
else if (_productos.Count == 0)
{
    <p>No hay productos cargados todavía.</p>
}
else
{
    <table>
        <thead>
            <tr>
                <th>Código</th>
                <th>Nombre</th>
                <th>Categoría</th>
                <th>Unidad</th>
                <th>Costo unit.</th>
                <th>Existencia</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var p in _productos)
            {
                <tr class="@(p.Existencia < p.StockMinimo ? "bajo-stock" : "")">
                    <td>@p.CodigoProducto</td>
                    <td>@p.Nombre</td>
                    <td>@p.CategoriaNombre</td>
                    <td>@p.UnidadMedida</td>
                    <td>@(p.CostoUnitario?.ToString("N2") ?? "—")</td>
                    <td>@p.Existencia.ToString("N2")</td>
                    <td><a href="/movimientos/registrar?productoId=@p.Id">Movimiento</a></td>
                </tr>
            }
        </tbody>
    </table>
}

<style>
    table { border-collapse: collapse; width: 100%; margin-top: 1rem; }
    th, td { border: 1px solid #ddd; padding: .5rem .75rem; text-align: left; }
    th { background: #f7f9fc; }
    .bajo-stock { background: #fff3cd; }
    .error { color: #a33; font-weight: 600; }
</style>

@code {
    private List<ProductoDto>? _productos;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _productos = await ProductoApi.ListarAsync();
        }
        catch (ApiException ex)
        {
            _error = ex.Message;
            _productos = [];
        }
    }
}
