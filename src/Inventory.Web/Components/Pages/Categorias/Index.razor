@page "/categorias"
@rendermode InteractiveServer
@inject CategoriaApiClient CategoriaApi

<PageTitle>Categorías</PageTitle>

<h1>Categorías</h1>

@if (_error is not null)
{
    <p class="error">@_error</p>
}

<EditForm Model="_modelo" OnValidSubmit="CrearAsync" FormName="crearCategoria">
    <div class="fila">
        <div class="campo">
            <label>Código</label>
            <InputText @bind-Value="_modelo.CodigoCategoria" placeholder="CEREALES" />
        </div>
        <div class="campo">
            <label>Descripción</label>
            <InputText @bind-Value="_modelo.Descripcion" placeholder="Cereales" />
        </div>
        <button type="submit" disabled="@_guardando">@(_guardando ? "Guardando…" : "Agregar")</button>
    </div>
</EditForm>

@if (_categorias is null)
{
    <p>Cargando…</p>
}
else
{
    <table>
        <thead><tr><th>Código</th><th>Descripción</th></tr></thead>
        <tbody>
            @foreach (var c in _categorias)
            {
                <tr><td>@c.CodigoCategoria</td><td>@c.Descripcion</td></tr>
            }
        </tbody>
    </table>
}

<style>
    .fila { display: flex; gap: 1rem; align-items: flex-end; margin-bottom: 1.25rem; flex-wrap: wrap; }
    .campo { display: flex; flex-direction: column; gap: .25rem; }
    label { font-weight: 600; font-size: .85rem; }
    input { padding: .4rem; border: 1px solid #ccc; border-radius: 4px; min-width: 220px; }
    button { padding: .5rem 1rem; background: #1f3864; color: #fff; border: none; border-radius: 4px; cursor: pointer; height: fit-content; }
    button:disabled { opacity: .6; cursor: default; }
    table { border-collapse: collapse; width: 100%; }
    th, td { border: 1px solid #ddd; padding: .5rem .75rem; text-align: left; }
    th { background: #f7f9fc; }
    .error { color: #a33; font-weight: 600; }
</style>

@code {
    private List<CategoriaDto>? _categorias;
    private readonly Modelo _modelo = new();
    private bool _guardando;
    private string? _error;

    protected override async Task OnInitializedAsync() => await CargarAsync();

    private async Task CargarAsync()
    {
        try { _categorias = await CategoriaApi.ListarAsync(); }
        catch (ApiException ex) { _error = ex.Message; _categorias = []; }
    }

    private async Task CrearAsync()
    {
        if (_guardando) return;
        _guardando = true;
        _error = null;
        try
        {
            await CategoriaApi.CrearAsync(new CrearCategoriaDto(_modelo.CodigoCategoria, _modelo.Descripcion));
            _modelo.CodigoCategoria = "";
            _modelo.Descripcion = "";
            await CargarAsync();
        }
        catch (ApiException ex) { _error = ex.Message; }
        finally { _guardando = false; }
    }

    private class Modelo
    {
        public string CodigoCategoria { get; set; } = "";
        public string? Descripcion { get; set; }
    }
}
