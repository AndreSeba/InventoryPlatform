@page "/movimientos/registrar"
@rendermode InteractiveServer
@inject ProductoApiClient ProductoApi
@inject UbicacionApiClient UbicacionApi
@inject MovimientoApiClient MovimientoApi

<PageTitle>Registrar movimiento</PageTitle>

<h1>Movimiento de inventario</h1>

@if (_productos is null || _ubicaciones is null)
{
    <p>Cargando…</p>
}
else
{
    @if (_error is not null)
    {
        <p class="error">@_error</p>
    }
    @if (_resultado is not null)
    {
        <p class="ok">Movimiento @_resultado.NumeroMovimiento confirmado. Existencia resultante del producto: @_resultado.ExistenciaResultante.ToString("N2")</p>
    }

    <div class="campo tipo">
        <label><input type="radio" name="tipo" checked="@(_tipo == "entrada")" @onchange="@(() => _tipo = "entrada")" /> Entrada</label>
        <label><input type="radio" name="tipo" checked="@(_tipo == "salida")" @onchange="@(() => _tipo = "salida")" /> Salida</label>
        <label><input type="radio" name="tipo" checked="@(_tipo == "ajuste_pos")" @onchange="@(() => _tipo = "ajuste_pos")" /> Ajuste positivo</label>
        <label><input type="radio" name="tipo" checked="@(_tipo == "ajuste_neg")" @onchange="@(() => _tipo = "ajuste_neg")" /> Ajuste negativo</label>
    </div>

    <div class="campo">
        <label>Producto</label>
        <select @bind="_productoId">
            <option value="0">-- Seleccionar --</option>
            @foreach (var p in _productos)
            {
                <option value="@p.Id">@p.CodigoProducto — @p.Nombre</option>
            }
        </select>
    </div>

    <div class="campo">
        <label>Ubicación</label>
        <select @bind="_ubicacionId">
            <option value="0">-- Seleccionar --</option>
            @foreach (var u in _ubicaciones)
            {
                <option value="@u.Id">@u.CodigoUbicacion (@u.TipoUbicacion)</option>
            }
        </select>
        @if (_productoId > 0 && _ubicacionId > 0)
        {
            <span class="ayuda">Existencia en esta ubicación: @ExistenciaEnUbicacionSeleccionada().ToString("N2")</span>
        }
    </div>

    <div class="campo">
        <label>Cantidad</label>
        <input type="number" step="0.01" @bind="_cantidad" />
    </div>

    @if (_tipo == "salida")
    {
        <div class="campo">
            <label><input type="checkbox" @bind="_retorna" /> Es un préstamo (espera devolución)</label>
        </div>
        @if (_retorna)
        {
            <div class="campo">
                <label>Ubicación externa / destino</label>
                <input type="text" @bind="_ubicacionExterna" placeholder="Ej. Evento Trade Marketing, sucursal X" />
            </div>
            <div class="campo">
                <label>Fecha de retorno esperada</label>
                <input type="date" @bind="_fechaRetorno" />
            </div>
        }
    }

    <div class="campo">
        <label>Motivo</label>
        <textarea @bind="_motivo"></textarea>
    </div>

    <button disabled="@_guardando" @onclick="RegistrarAsync">@(_guardando ? "Guardando…" : "Guardar")</button>
    <a href="/productos">Volver al catálogo</a>
}

<style>
    .campo { margin-bottom: .75rem; display: flex; flex-direction: column; gap: .25rem; max-width: 420px; }
    .campo.tipo { flex-direction: row; gap: 1.25rem; align-items: center; flex-wrap: wrap; max-width: none; }
    label { font-weight: 600; }
    input, select, textarea { padding: .4rem; border: 1px solid #ccc; border-radius: 4px; }
    button { margin-top: .5rem; padding: .5rem 1rem; background: #1f3864; color: #fff; border: none; border-radius: 4px; cursor: pointer; }
    button:disabled { opacity: .6; cursor: default; }
    .error { color: #a33; font-weight: 600; }
    .ok { color: #2a7a2a; font-weight: 600; }
    .ayuda { font-size: .8rem; color: #666; font-weight: 400; }
</style>

@code {
    [SupplyParameterFromQuery]
    public int? ProductoId { get; set; }

    private List<ProductoDto>? _productos;
    private List<UbicacionDto>? _ubicaciones;
    private List<MovimientoDto> _movimientosProducto = [];

    private string _tipo = "entrada";
    private int _productoId;
    private int _ubicacionId;
    private decimal _cantidad;
    private bool _retorna;
    private string? _ubicacionExterna;
    private DateTime? _fechaRetorno;
    private string? _motivo;
    private bool _guardando;
    private string? _error;
    private MovimientoResultadoDto? _resultado;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _productos = await ProductoApi.ListarAsync();
            _ubicaciones = await UbicacionApi.ListarAsync();
            if (ProductoId is > 0)
                _productoId = ProductoId.Value;
        }
        catch (ApiException ex)
        {
            _error = ex.Message;
            _productos = [];
            _ubicaciones = [];
        }
    }

    private decimal ExistenciaEnUbicacionSeleccionada() =>
        _movimientosProducto.Where(m => m.UbicacionId == _ubicacionId)
            .Sum(m => m.TipoMovimiento is Inventory.Domain.Enums.TipoMovimiento.Entrada or Inventory.Domain.Enums.TipoMovimiento.AjustePositivo ? m.Cantidad : -m.Cantidad);

    private async Task RegistrarAsync()
    {
        if (_guardando) return;

        if (_productoId <= 0) { _error = "Seleccioná un producto."; return; }
        if (_ubicacionId <= 0) { _error = "Seleccioná una ubicación."; return; }
        if (_cantidad <= 0) { _error = "La cantidad debe ser mayor a cero."; return; }

        _guardando = true;
        _error = null;
        _resultado = null;

        try
        {
            _resultado = _tipo switch
            {
                "entrada" => await MovimientoApi.RegistrarEntradaAsync(new RegistrarEntradaDto(_productoId, _ubicacionId, _cantidad, _motivo)),
                "salida" => await MovimientoApi.RegistrarSalidaAsync(new RegistrarSalidaDto(
                    _productoId, _ubicacionId, _cantidad, _motivo, _retorna, _retorna ? _ubicacionExterna : null,
                    _retorna && _fechaRetorno is not null ? DateOnly.FromDateTime(_fechaRetorno.Value) : null, null)),
                "ajuste_pos" => await MovimientoApi.RegistrarAjusteAsync(new RegistrarAjusteDto(_productoId, _ubicacionId, _cantidad, true, _motivo ?? "Ajuste positivo")),
                "ajuste_neg" => await MovimientoApi.RegistrarAjusteAsync(new RegistrarAjusteDto(_productoId, _ubicacionId, _cantidad, false, _motivo ?? "Ajuste negativo")),
                _ => throw new InvalidOperationException(),
            };

            _productos = await ProductoApi.ListarAsync();
            _movimientosProducto = await MovimientoApi.ListarPorProductoAsync(_productoId);
            _cantidad = 0;
            _motivo = null;
            _retorna = false;
            _ubicacionExterna = null;
            _fechaRetorno = null;
        }
        catch (ApiException ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _guardando = false;
        }
    }
}
