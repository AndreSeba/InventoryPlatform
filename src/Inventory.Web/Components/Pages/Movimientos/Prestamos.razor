@page "/movimientos/prestamos"
@rendermode InteractiveServer
@inject MovimientoApiClient MovimientoApi
@inject UbicacionApiClient UbicacionApi

<PageTitle>Préstamos pendientes</PageTitle>

<h1>Préstamos pendientes de devolución</h1>
<p class="ayuda">Salidas registradas con "Es un préstamo" que todavía no tienen una devolución que las cierre por completo.</p>

@if (_error is not null)
{
    <p class="error">@_error</p>
}
@if (_ok is not null)
{
    <p class="ok">@_ok</p>
}

@if (_prestamos is null || _ubicaciones is null)
{
    <p>Cargando…</p>
}
else if (_prestamos.Count == 0)
{
    <p>No hay préstamos pendientes.</p>
}
else
{
    <table>
        <thead>
            <tr>
                <th>N.º movimiento</th><th>Producto</th><th>Cantidad</th><th>Destino</th>
                <th>Retorno esperado</th><th>Fecha salida</th><th>Devolver</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var m in _prestamos)
            {
                <tr>
                    <td>@m.NumeroMovimiento</td>
                    <td>@m.ProductoNombre</td>
                    <td>@m.Cantidad.ToString("N2")</td>
                    <td>@m.UbicacionExterna</td>
                    <td>@(m.FechaRetornoEsperada?.ToString("dd/MM/yyyy") ?? "—")</td>
                    <td>@m.FechaMovimiento.ToLocalTime().ToString("dd/MM/yyyy")</td>
                    <td>
                        <input type="number" step="0.01" style="width:90px" @bind="_cantidadDevolucion[m.Id]" />
                        <select @bind="_ubicacionDevolucion[m.Id]" style="width:120px">
                            <option value="0">Ubicación…</option>
                            @foreach (var u in _ubicaciones)
                            {
                                <option value="@u.Id">@u.CodigoUbicacion</option>
                            }
                        </select>
                        <button disabled="@_guardando" @onclick="() => DevolverAsync(m.Id)">Devolver</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

<style>
    table { border-collapse: collapse; width: 100%; margin-top: 1rem; }
    th, td { border: 1px solid #ddd; padding: .5rem .75rem; text-align: left; }
    th { background: #f7f9fc; }
    .error { color: #a33; font-weight: 600; }
    .ok { color: #2a7a2a; font-weight: 600; }
    .ayuda { color: #666; }
    button { padding: .3rem .7rem; background: #1f3864; color: #fff; border: none; border-radius: 4px; cursor: pointer; }
    button:disabled { opacity: .6; cursor: default; }
</style>

@code {
    private List<MovimientoDto>? _prestamos;
    private List<UbicacionDto>? _ubicaciones;
    private readonly Dictionary<int, decimal> _cantidadDevolucion = new();
    private readonly Dictionary<int, int> _ubicacionDevolucion = new();
    private bool _guardando;
    private string? _error;
    private string? _ok;

    protected override async Task OnInitializedAsync() => await CargarAsync();

    private async Task CargarAsync()
    {
        try
        {
            _prestamos = await MovimientoApi.ListarPrestamosPendientesAsync();
            _ubicaciones = await UbicacionApi.ListarAsync();
        }
        catch (ApiException ex)
        {
            _error = ex.Message;
            _prestamos = [];
            _ubicaciones = [];
        }
    }

    private async Task DevolverAsync(int movimientoOrigenId)
    {
        if (_guardando) return;

        var cantidad = _cantidadDevolucion.GetValueOrDefault(movimientoOrigenId);
        var ubicacionId = _ubicacionDevolucion.GetValueOrDefault(movimientoOrigenId);

        if (cantidad <= 0) { _error = "Indicá la cantidad a devolver."; return; }
        if (ubicacionId <= 0) { _error = "Seleccioná dónde vuelve el material."; return; }

        _guardando = true;
        _error = null;
        _ok = null;

        try
        {
            var resultado = await MovimientoApi.RegistrarDevolucionAsync(new RegistrarDevolucionDto(movimientoOrigenId, ubicacionId, cantidad, "Devolución de préstamo"));
            _ok = $"Devolución {resultado.NumeroMovimiento} registrada.";
            await CargarAsync();
        }
        catch (ApiException ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _guardando = false;
        }
    }
}
