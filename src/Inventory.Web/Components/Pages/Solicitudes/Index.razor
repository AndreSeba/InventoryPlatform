@page "/solicitudes"
@rendermode InteractiveServer
@inject SolicitudApiClient SolicitudApi

<PageTitle>Solicitudes</PageTitle>

<h1>Solicitudes</h1>

<p><a href="/solicitudes/crear">+ Nueva solicitud</a></p>

@if (_error is not null)
{
    <p class="error">@_error</p>
}

<div class="campo">
    <label>Estado</label>
    <select @bind="_estado" @bind:after="CargarAsync">
        <option value="">-- Todos --</option>
        <option value="Pendiente">Pendiente</option>
        <option value="Aprobada">Aprobada</option>
        <option value="EntregadaParcial">Entregada parcial</option>
        <option value="Entregada">Entregada</option>
        <option value="Rechazada">Rechazada</option>
    </select>
</div>

@if (_solicitudes is null)
{
    <p>Cargando…</p>
}
else if (_solicitudes.Count == 0)
{
    <p>No hay solicitudes con ese filtro.</p>
}
else
{
    <table>
        <thead><tr><th>N.º</th><th>Área</th><th>Estado</th><th>Solicitado por</th><th>Fecha</th><th></th></tr></thead>
        <tbody>
            @foreach (var s in _solicitudes)
            {
                <tr>
                    <td>@s.NumeroSolicitud</td>
                    <td>@s.AreaNombre</td>
                    <td>@s.Estado</td>
                    <td>@s.SolicitadoPor</td>
                    <td>@s.FechaSolicitud.ToLocalTime().ToString("dd/MM/yyyy")</td>
                    <td><a href="/solicitudes/@s.Id">Ver</a></td>
                </tr>
            }
        </tbody>
    </table>
}

<style>
    .campo { margin: 1rem 0; display: flex; flex-direction: column; gap: .25rem; max-width: 260px; }
    label { font-weight: 600; font-size: .85rem; }
    select { padding: .4rem; border: 1px solid #ccc; border-radius: 4px; }
    table { border-collapse: collapse; width: 100%; }
    th, td { border: 1px solid #ddd; padding: .5rem .75rem; text-align: left; }
    th { background: #f7f9fc; }
    .error { color: #a33; font-weight: 600; }
</style>

@code {
    private List<SolicitudDto>? _solicitudes;
    private string _estado = "";
    private string? _error;

    protected override async Task OnInitializedAsync() => await CargarAsync();

    private async Task CargarAsync()
    {
        try { _solicitudes = await SolicitudApi.ListarAsync(string.IsNullOrEmpty(_estado) ? null : _estado); }
        catch (ApiException ex) { _error = ex.Message; _solicitudes = []; }
    }
}
