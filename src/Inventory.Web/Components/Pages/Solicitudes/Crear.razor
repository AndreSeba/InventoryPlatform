@page "/solicitudes/crear"
@rendermode InteractiveServer
@inject SolicitudApiClient SolicitudApi
@inject AreaApiClient AreaApi
@inject ProductoApiClient ProductoApi
@inject NavigationManager Nav

<PageTitle>Nueva solicitud</PageTitle>

<h1>Nueva solicitud</h1>

@if (_error is not null)
{
    <p class="error">@_error</p>
}

@if (_areas is null || _productos is null)
{
    <p>Cargando…</p>
}
else
{
    <div class="campo">
        <label>Área solicitante</label>
        <select @bind="_areaId">
            <option value="0">-- Seleccionar --</option>
            @foreach (var a in _areas)
            {
                <option value="@a.Id">@a.NombreArea</option>
            }
        </select>
    </div>

    <h3>Líneas</h3>
    @foreach (var linea in _lineas)
    {
        <div class="linea">
            <select @bind="linea.ProductoId">
                <option value="0">-- Producto --</option>
                @foreach (var p in _productos)
                {
                    <option value="@p.Id">@p.CodigoProducto — @p.Nombre</option>
                }
            </select>
            <input type="number" step="0.01" placeholder="Cantidad" @bind="linea.Cantidad" style="width:120px" />
            <button type="button" @onclick="() => _lineas.Remove(linea)">Quitar</button>
        </div>
    }
    <button type="button" @onclick="() => _lineas.Add(new Linea())">+ Agregar línea</button>

    <div style="margin-top:1.5rem">
        <button disabled="@_guardando" @onclick="GuardarAsync">@(_guardando ? "Enviando…" : "Enviar solicitud")</button>
        <a href="/solicitudes">Cancelar</a>
    </div>
}

<style>
    .campo { margin-bottom: 1rem; display: flex; flex-direction: column; gap: .25rem; max-width: 320px; }
    label { font-weight: 600; }
    select, input { padding: .4rem; border: 1px solid #ccc; border-radius: 4px; }
    .linea { display: flex; gap: .75rem; align-items: center; margin-bottom: .5rem; }
    button { padding: .5rem 1rem; background: #1f3864; color: #fff; border: none; border-radius: 4px; cursor: pointer; }
    button:disabled { opacity: .6; cursor: default; }
    .error { color: #a33; font-weight: 600; }
</style>

@code {
    private List<AreaDto>? _areas;
    private List<ProductoDto>? _productos;
    private int _areaId;
    private readonly List<Linea> _lineas = [new()];
    private bool _guardando;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _areas = await AreaApi.ListarAsync();
            _productos = await ProductoApi.ListarAsync();
        }
        catch (ApiException ex)
        {
            _error = ex.Message;
            _areas = [];
            _productos = [];
        }
    }

    private async Task GuardarAsync()
    {
        if (_guardando) return;

        if (_areaId <= 0) { _error = "Seleccioná el área solicitante."; return; }

        var lineasValidas = _lineas.Where(l => l.ProductoId > 0 && l.Cantidad > 0).ToList();
        if (lineasValidas.Count == 0) { _error = "Agregá al menos una línea con producto y cantidad."; return; }

        _guardando = true;
        _error = null;

        try
        {
            var detalles = lineasValidas.Select(l => new CrearSolicitudDetalleDto(l.ProductoId, l.Cantidad)).ToList();
            var creada = await SolicitudApi.CrearAsync(new CrearSolicitudDto(_areaId, detalles));
            Nav.NavigateTo($"/solicitudes/{creada.Id}");
        }
        catch (ApiException ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _guardando = false;
        }
    }

    private class Linea
    {
        public int ProductoId { get; set; }
        public decimal Cantidad { get; set; }
    }
}
