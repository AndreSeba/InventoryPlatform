@page "/solicitudes/{Id:int}"
@rendermode InteractiveServer
@using Inventory.Domain.Enums
@inject SolicitudApiClient SolicitudApi
@inject MovimientoApiClient MovimientoApi
@inject UbicacionApiClient UbicacionApi

<PageTitle>Solicitud</PageTitle>

@if (_error is not null)
{
    <p class="error">@_error</p>
}
@if (_ok is not null)
{
    <p class="ok">@_ok</p>
}

@if (_solicitud is null || _ubicaciones is null)
{
    <p>Cargando…</p>
}
else
{
    <h1>Solicitud @_solicitud.NumeroSolicitud</h1>
    <p>
        <strong>Área:</strong> @_solicitud.AreaNombre &nbsp;|&nbsp;
        <strong>Estado:</strong> @_solicitud.Estado &nbsp;|&nbsp;
        <strong>Solicitado por:</strong> @_solicitud.SolicitadoPor
    </p>
    @if (_solicitud.Estado == EstadoSolicitud.Rechazada)
    {
        <p class="error">Motivo de rechazo: @_solicitud.MotivoRechazo</p>
    }

    <table>
        <thead>
            <tr>
                <th>Producto</th><th>Solicitada</th><th>Aprobada</th><th>Entregada</th>
                @if (_solicitud.Estado == EstadoSolicitud.Pendiente)
                {
                    <th>Aprobar cantidad</th>
                }
                else if (_solicitud.Estado is EstadoSolicitud.Aprobada or EstadoSolicitud.EntregadaParcial)
                {
                    <th>Registrar entrega</th>
                }
            </tr>
        </thead>
        <tbody>
            @foreach (var d in _solicitud.Detalles)
            {
                <tr>
                    <td>@d.ProductoNombre</td>
                    <td>@d.CantidadSolicitada.ToString("N2")</td>
                    <td>@(d.CantidadAprobada?.ToString("N2") ?? "—")</td>
                    <td>@d.CantidadEntregada.ToString("N2")</td>
                    @if (_solicitud.Estado == EstadoSolicitud.Pendiente)
                    {
                        <td><input type="number" step="0.01" style="width:100px" @bind="_cantidadAprobada[d.Id]" /></td>
                    }
                    else if (_solicitud.Estado is EstadoSolicitud.Aprobada or EstadoSolicitud.EntregadaParcial && d.CantidadAprobada > d.CantidadEntregada)
                    {
                        <td>
                            <input type="number" step="0.01" style="width:90px" @bind="_cantidadEntrega[d.Id]" />
                            <select @bind="_ubicacionEntrega[d.Id]" style="width:120px">
                                <option value="0">Ubicación…</option>
                                @foreach (var u in _ubicaciones)
                                {
                                    <option value="@u.Id">@u.CodigoUbicacion</option>
                                }
                            </select>
                            <button disabled="@_guardando" @onclick="() => EntregarAsync(d.Id)">Entregar</button>
                        </td>
                    }
                </tr>
            }
        </tbody>
    </table>

    @if (_solicitud.Estado == EstadoSolicitud.Pendiente)
    {
        <div class="acciones">
            <button disabled="@_guardando" @onclick="AprobarAsync">Aprobar solicitud</button>
            <input type="text" placeholder="Motivo de rechazo" @bind="_motivoRechazo" style="width:280px" />
            <button disabled="@_guardando" class="rechazar" @onclick="RechazarAsync">Rechazar</button>
        </div>
    }

    <p><a href="/solicitudes">Volver al listado</a></p>
}

<style>
    table { border-collapse: collapse; width: 100%; margin: 1rem 0; }
    th, td { border: 1px solid #ddd; padding: .5rem .75rem; text-align: left; }
    th { background: #f7f9fc; }
    .acciones { display: flex; gap: .75rem; align-items: center; margin-top: 1rem; }
    button { padding: .5rem 1rem; background: #1f3864; color: #fff; border: none; border-radius: 4px; cursor: pointer; }
    button.rechazar { background: #a33; }
    button:disabled { opacity: .6; cursor: default; }
    input, select { padding: .4rem; border: 1px solid #ccc; border-radius: 4px; }
    .error { color: #a33; font-weight: 600; }
    .ok { color: #2a7a2a; font-weight: 600; }
</style>

@code {
    [Parameter] public int Id { get; set; }

    private SolicitudDto? _solicitud;
    private List<UbicacionDto>? _ubicaciones;
    private readonly Dictionary<int, decimal> _cantidadAprobada = new();
    private readonly Dictionary<int, decimal> _cantidadEntrega = new();
    private readonly Dictionary<int, int> _ubicacionEntrega = new();
    private string? _motivoRechazo;
    private bool _guardando;
    private string? _error;
    private string? _ok;

    protected override async Task OnInitializedAsync() => await CargarAsync();

    private async Task CargarAsync()
    {
        try
        {
            _solicitud = await SolicitudApi.ObtenerPorIdAsync(Id);
            _ubicaciones = await UbicacionApi.ListarAsync();
            if (_solicitud is not null)
                foreach (var d in _solicitud.Detalles)
                    _cantidadAprobada.TryAdd(d.Id, d.CantidadSolicitada);
        }
        catch (ApiException ex)
        {
            _error = ex.Message;
        }
    }

    private async Task AprobarAsync()
    {
        if (_guardando || _solicitud is null) return;
        _guardando = true;
        _error = null;

        try
        {
            var lineas = _solicitud.Detalles
                .Select(d => new AprobarSolicitudDetalleDto(d.Id, _cantidadAprobada.GetValueOrDefault(d.Id)))
                .Where(l => l.CantidadAprobada > 0)
                .ToList();

            _solicitud = await SolicitudApi.AprobarAsync(Id, new AprobarSolicitudDto(lineas));
            _ok = "Solicitud aprobada.";
        }
        catch (ApiException ex) { _error = ex.Message; }
        finally { _guardando = false; }
    }

    private async Task RechazarAsync()
    {
        if (_guardando) return;
        if (string.IsNullOrWhiteSpace(_motivoRechazo)) { _error = "Indicá el motivo de rechazo."; return; }

        _guardando = true;
        _error = null;

        try
        {
            _solicitud = await SolicitudApi.RechazarAsync(Id, new RechazarSolicitudDto(_motivoRechazo));
            _ok = "Solicitud rechazada.";
        }
        catch (ApiException ex) { _error = ex.Message; }
        finally { _guardando = false; }
    }

    private async Task EntregarAsync(int solicitudDetalleId)
    {
        if (_guardando || _solicitud is null) return;

        var detalle = _solicitud.Detalles.First(d => d.Id == solicitudDetalleId);
        var cantidad = _cantidadEntrega.GetValueOrDefault(solicitudDetalleId);
        var ubicacionId = _ubicacionEntrega.GetValueOrDefault(solicitudDetalleId);

        if (cantidad <= 0) { _error = "Indicá la cantidad a entregar."; return; }
        if (ubicacionId <= 0) { _error = "Seleccioná desde qué ubicación sale."; return; }

        _guardando = true;
        _error = null;

        try
        {
            await MovimientoApi.RegistrarSalidaAsync(new RegistrarSalidaDto(
                detalle.ProductoId, ubicacionId, cantidad, $"Entrega solicitud {_solicitud.NumeroSolicitud}",
                false, null, null, solicitudDetalleId));

            _ok = "Entrega registrada.";
            await CargarAsync();
        }
        catch (ApiException ex) { _error = ex.Message; }
        finally { _guardando = false; }
    }
}
